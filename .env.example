# Copy to .env and replace every CHANGE_ME value. .env is gitignored.
# Generate strong values, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Do not use special characters that need shell/URL escaping (use token_urlsafe).

COMPOSE_PROJECT_NAME=monitoring-3tier

# --- PostgreSQL ---------------------------------------------------------
# Bootstrap superuser: used only by the init script and admin tasks.
POSTGRES_ADMIN_USER=pgadmin
POSTGRES_ADMIN_PASSWORD=CHANGE_ME

# Application database and its non-superuser owner role (used by the backend).
APP_DB_NAME=tasks
APP_DB_USER=tasks_app
APP_DB_PASSWORD=CHANGE_ME

# Least-privilege monitoring role (granted pg_monitor; name must not start with pg_) used by postgres-exporter.
EXPORTER_DB_USER=exporter_monitor
EXPORTER_DB_PASSWORD=CHANGE_ME

# --- Backend --------------------------------------------------------------
# The backend connects as APP_DB_USER (never the admin user). Optional:
# BACKEND_LOG_LEVEL=INFO

# --- Frontend (nginx) -------------------------------------------------------
# Host port for the UI, bound to 127.0.0.1 only. Default 8088; change it if that
# port is already used on your machine.
# FRONTEND_HOST_PORT=8088

# --- Grafana ----------------------------------------------------------------
# Admin account for the Grafana UI (http://127.0.0.1:GRAFANA_HOST_PORT). There is no default
# password: replace CHANGE_ME with a strong secret.
GRAFANA_ADMIN_USER=grafana_admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
# Host port, bound to 127.0.0.1 only. Default 3001 (3000 is used by other projects on the dev machine).
# GRAFANA_HOST_PORT=3001
