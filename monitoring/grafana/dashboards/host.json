    "monitoring-3tier",
    "host",
    "node-exporter"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Monitoring dashboards",
      "type": "dashboards",
      "asDropdown": true,
      "tags": [
        "monitoring-3tier"
      ],
      "includeVars": false,
      "keepTime": true
    }
